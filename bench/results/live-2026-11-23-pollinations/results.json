          "path": "script/compute.py",
          "status": "added",
          "content": "import csv, json\npath='data/sales.csv'\nseen=set(); skipped=0; total=0.0; by={}\nwith open(path) as f:\n    reader=csv.DictReader(f)\n    for row in reader:\n        oid=row['order_id']\n        if oid in seen:\n            skipped+=1; continue\n        seen.add(oid)\n        try:\n            units=float(row['units']); price=float(row['unit_price'])\n        except Exception:\n            skipped+=1; continue\n        rev=units*price\n        total+=rev\n        by[row['region']]=by.get(row['region'],0)+rev\nif by:\n    top=max(by.items(), key=lambda x:x[1])[0]\nelse:\n    top=None\nsummary={'totalRevenue':round(total,2),\n          'byRegion':{k:round(v,2) for k,v in by.items()},\n          'topRegion':top,\n          'skippedRows':skipped}\nopen('report/summary.json','w').write(json.dumps(summary,indent=2))\nwith open('report/summary.md','w') as f:\n    f.write(f\"Total Revenue: ${summary['totalRevenue']:.2f}\\n\")\n    f.write(f\"Top Region: {summary['topRegion']} (${summary['byRegion'][summary['topRegion']]:.2f})\\n\")\n    f.write(f\"Skipped Rows: {summary['skippedRows']}\\n\")\n"
