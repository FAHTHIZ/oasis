          "path": "scripts/archive-logs.mjs",
          "status": "added",
          "content": "#!/usr/bin/env node\n\nimport fs from 'fs';\nimport path from 'node:path';\n\nfunction exitWithStatus(code){\n  process.exit(code);\n}\n\nfunction parseArgs(){\n  const args = process.argv.slice(2);\n  const result = {before: null, dir: 'logs'};\n  for (let i=0; i<args.length; i++){\n    const a=args[i];\n    if (a=== '--before' && i+1<args.length){\n      result.before=args[i+1]; i++;\n    } else if (a=== '--dir' && i+1<args.length){\n      result.dir=args[i+1]; i++;\n    }\n  }\n  return result;\n}\n\nfunction isValidDate(str){\n  return /^\\d{4}-\\d{2}-\\d{2}$/.test(str) && !isNaN(Date.parse(str)) && new Date(str).toISOString().slice(0,10)===str;\n}\n\nfunction main(){\n  const args=parseArgs();\n  if (!args.before || !isValidDate(args.before)){\n    exitWithStatus(2);\n  }\n  const baseDir=path.resolve(args.dir);\n  const files=fs.readdirSync(baseDir).filter(f=>f.startsWith('app-') && f.endsWith('.log'));\n  const moved=[];\n  const beforeDate=new Date(args.before);\n  files.forEach(f=>{\n    const dateStr=f.slice(4,-4); // YYYY-MM-DD\n    const fileDate=new Date(dateStr);\n    if (fileDate<beforeDate){\n      const monthPath=path.join(baseDir,'archive',dateStr.slice(0,7));\n      if (!fs.existsSync(monthPath)) fs.mkdirSync(monthPath, {recursive:true});\n      const src=path.join(baseDir,f);\n      const dest=path.join(monthPath,f);\n      fs.renameSync(src,dest);\n      moved.push({file: f, to: path.join('archive',dateStr.slice(0,7),f).replace(/\\\\/g,'/')});\n    }\n  });\n  if (moved.length>0){\n    const manifestPath=path.join(baseDir,'archive','manifest.json');\n    let manifest={moved: []};\n    if (fs.existsSync(manifestPath)){\n      const data=fs.readFileSync(manifestPath, 'utf8');\n      try{manifest=JSON.parse(data);}catch(e){}\n    }\n    manifest.moved=manifest.moved.concat(moved);\n    fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));\n  }\n}\n\nmain();\n"
        },
