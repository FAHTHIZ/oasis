{
  "name": "oasis-oss",
  "version": "0.2.0",
  "description": "Open-source AI coding agent with a CLI, local browser workspace, multi-provider tools, MCP, skills, and subagents.",
  "type": "module",
  "main": "./src/sdk.mjs",
  "exports": {
    ".": "./src/sdk.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oasis": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "index.html",
    "manifest.webmanifest",
    "sw.js",
    "assets/",
    "scripts/",
    "skills/",
    "plugins/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/",
    "evals/"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-site.mjs && node --test && node src/cli.mjs eval --validate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gtxnrg-ship-it/Oasis.git"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "developer-tools",
    "cli",
    "llm",
    "mcp",
    "model-context-protocol",
    "local-first",
    "agentic-workflows",
    "open-source",
    "javascript",
    "nodejs"
  ]
}
