{
  "name": "oasis-oss",
  "version": "1.3.0",
  "description": "Open-source, model-agnostic coding-agent runtime with a remote-first browser workspace and terminal agent: real shell, files, MCP, subagents and approvals.",
  "type": "module",
  "main": "./src/sdk.mjs",
  "exports": {
    ".": "./src/sdk.mjs",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0",
    "sharp": "0.35.5"
  },
  "bin": {
    "oasis": "./src/oasis.mjs"
  },
  "files": [
    "src/",
    "app/",
    "sw.js",
    "assets/",
    "scripts/",
    "skills/",
    "plugins/",
    "ide/",
    "README.md",
    "LICENSE",
    "evals/",
    "!assets/demo/",
    "!assets/screenshots/",
    "!scripts/demo/"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check:quick": "node .github/scripts/check-eval-quarantine.mjs && node bench/harness/run.mjs --check && node bench/tokens/run.mjs --check",
    "check": "node .github/scripts/check-eval-quarantine.mjs && node --test test/*.test.mjs && node bench/harness/run.mjs --check && node bench/tokens/run.mjs --check && node src/cli.mjs eval --validate && node src/cli.mjs eval --negative-control",
    "postinstall": "node scripts/vendor-terminal.mjs",
    "prepack": "node scripts/vendor-terminal.mjs",
    "bench:search": "node scripts/bench-web-search.mjs",
    "bench:harness": "node bench/harness/run.mjs",
    "bench:tokens": "node bench/tokens/run.mjs",
    "bench:live": "node scripts/bench-live.mjs",
    "bench:startup": "node scripts/measure-startup.mjs",
    "bench:memory": "node scripts/bench-memory.mjs",
    "lint": "oxlint --deny-warnings"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FAHTHIZ/oasis.git"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "agent-runtime",
    "model-agnostic",
    "agentic-workflows",
    "multi-agent",
    "llm",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "developer-tools",
    "cli",
    "terminal",
    "vscode",
    "vscode-extension",
    "ollama",
    "nodejs",
    "open-source",
    "web-workspace",
    "remote-development"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.5.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-tasks": "0.2.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/otlp-transformer": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@vscode/ripgrep": "1.18.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "croner": "^11.0.0",
    "defuddle": "^0.19.6",
    "diff": "^9.0.0",
    "entities": "9.0.0",
    "eventsource-parser": "^4.1.3",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.1.1",
    "ipaddr.js": "^2.5.0",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "linkedom": "^0.18.15",
    "lowlight": "^3.3.0",
    "marked": "^18.2.0",
    "minisearch": "^7.2.0",
    "picomatch": "^4.0.7",
    "quickjs-emscripten": "0.32.0",
    "rrule-temporal": "2.2.8",
    "semver": "^7.8.6",
    "smol-toml": "1.9.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unbash": "^6.0.4",
    "undici": "^7.30.2",
    "unpdf": "^1.9.1",
    "vscode-jsonrpc": "^10.0.0",
    "wink-porter2-stemmer": "^2.0.1",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.22.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.93.0"
  },
  "author": {
    "name": "OASIS Contributors",
    "email": "noreply@github.com"
  },
  "oasisRelease": {
    "channel": "stable",
    "stableTag": "v1.3.0",
    "published": true
  },
  "homepage": "https://github.com/FAHTHIZ/oasis#readme",
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "$zod"
    }
  }
}
