{
  "name": "oasis-oss",
  "version": "1.1.1",
  "description": "Open-source, model-agnostic coding-agent runtime for CLI, native desktop, connected browser sessions and editor workflows.",
  "type": "module",
  "main": "./src/sdk.mjs",
  "exports": {
    ".": "./src/sdk.mjs",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0",
    "sharp": "0.35.5"
  },
  "bin": {
    "oasis": "./src/oasis.mjs"
  },
  "files": [
    "src/",
    "app/",
    "index.html",
    "manifest.webmanifest",
    "sw.js",
    "assets/",
    "scripts/",
    "skills/",
    "plugins/",
    "ide/",
    "README.md",
    "LICENSE",
    "evals/",
    "desktop/",
    "!assets/demo/",
    "!assets/screenshots/",
    "!scripts/demo/"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check:quick": "node scripts/check-browser-app.mjs && node .github/scripts/check-eval-quarantine.mjs && node bench/harness/run.mjs --check && node bench/tokens/run.mjs --check",
    "check": "node scripts/check-browser-app.mjs && node .github/scripts/check-eval-quarantine.mjs && node --test test/*.test.mjs && node bench/harness/run.mjs --check && node bench/tokens/run.mjs --check && node src/cli.mjs eval --validate && node src/cli.mjs eval --negative-control",
    "postinstall": "node scripts/vendor-terminal.mjs",
    "prepack": "node scripts/vendor-terminal.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:dir": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "bench:search": "node scripts/bench-web-search.mjs",
    "bench:harness": "node bench/harness/run.mjs",
    "bench:tokens": "node bench/tokens/run.mjs",
    "bench:live": "node scripts/bench-live.mjs",
    "bench:startup": "node scripts/measure-startup.mjs",
    "lint": "oxlint --deny-warnings"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FAHTHIZ/oasis.git"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "agent-runtime",
    "model-agnostic",
    "agentic-workflows",
    "multi-agent",
    "llm",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "developer-tools",
    "cli",
    "terminal",
    "electron",
    "vscode",
    "vscode-extension",
    "ollama",
    "nodejs",
    "open-source"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-tasks": "0.2.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@vscode/ripgrep": "1.18.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "croner": "^11.0.0",
    "defuddle": "^0.19.6",
    "diff": "^9.0.0",
    "entities": "9.0.0",
    "eventsource-parser": "^4.1.3",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.1.0",
    "ipaddr.js": "^2.5.0",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "linkedom": "^0.18.15",
    "lowlight": "^3.3.0",
    "marked": "^18.1.3",
    "minisearch": "^7.2.0",
    "picomatch": "^4.0.7",
    "quickjs-emscripten": "0.32.0",
    "semver": "^7.8.6",
    "smol-toml": "1.9.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unbash": "6.0.3",
    "undici": "^7.30.2",
    "unpdf": "^1.9.1",
    "uqr": "^0.1.3",
    "vscode-jsonrpc": "^10.0.0",
    "wink-porter2-stemmer": "^2.0.1",
    "wrap-ansi": "^10.0.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "oxlint": "1.92.0"
  },
  "build": {
    "appId": "org.oasis.oss",
    "productName": "OASIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "desktop/**/*",
      "app/**/*",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*",
      "skills/**/*",
      "plugins/**/*",
      "ide/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OASIS uses the microphone only while you dictate a prompt."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OASIS"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icons/oasis-512.png"
    },
    "icon": "assets/icons/oasis-512.png"
  },
  "author": {
    "name": "OASIS Contributors",
    "email": "noreply@github.com"
  },
  "oasisRelease": {
    "channel": "stable",
    "stableTag": "v1.1.1",
    "published": true
  },
  "homepage": "https://github.com/FAHTHIZ/oasis#readme",
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "$zod"
    }
  }
}
