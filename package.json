{
  "name": "oasis-oss",
  "version": "1.1.0",
  "description": "Open-source, local-first agentic development workspace with CLI, browser, desktop and editor interfaces, multi-provider models, integrations, agent coordination, and verification.",
  "type": "module",
  "main": "./src/sdk.mjs",
  "exports": {
    ".": "./src/sdk.mjs",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "bin": {
    "oasis": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "index.html",
    "manifest.webmanifest",
    "sw.js",
    "assets/",
    "!assets/demo/",
    "scripts/",
    "skills/",
    "plugins/",
    "ide/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/",
    "evals/",
    "desktop/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:quick": "node scripts/check-site.mjs && node .github/scripts/check-public-site.mjs && node .github/scripts/check-eval-quarantine.mjs && node bench/harness/run.mjs --check",
  "check": "node scripts/check-site.mjs && node .github/scripts/check-public-site.mjs && node .github/scripts/check-eval-quarantine.mjs && node --test test/*.test.mjs && node bench/harness/run.mjs --check && node src/cli.mjs eval --validate && node src/cli.mjs eval --negative-control",
    "postinstall": "node scripts/vendor-terminal.mjs",
    "prepack": "node scripts/vendor-terminal.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:dir": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "bench:search": "node scripts/bench-web-search.mjs",
    "bench:harness": "node bench/harness/run.mjs",
    "bench:live": "node scripts/bench-live.mjs",
    "bench:startup": "node scripts/measure-startup.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FAHTHIZ/oasis.git"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "ai-agents",
    "developer-tools",
    "developer-workspace",
    "cli",
    "terminal-agent",
    "llm",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "agentic-workflows",
    "local-first",
    "open-source",
    "javascript",
    "nodejs",
    "automation",
    "subagents",
    "ollama",
    "multi-provider"
  ],
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.oasis.oss",
    "productName": "OASIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "desktop/**/*",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*",
      "skills/**/*",
      "plugins/**/*",
      "ide/**/*",
      "docs/**/*",
      "package.json",
      "LICENSE",
      "SECURITY.md",
      "CONTRIBUTING.md"
    ],
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OASIS uses the microphone only while you dictate a prompt."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OASIS"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icons/oasis-512.png"
    },
    "icon": "assets/icons/oasis-512.png"
  },
  "author": {
    "name": "OASIS Contributors",
    "email": "noreply@github.com"
  },
  "oasisRelease": {
    "channel": "stable",
    "stableTag": "v1.1.0",
    "published": true
  }
}
