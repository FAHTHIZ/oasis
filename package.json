{
  "name": "oasis-oss",
  "version": "0.2.0",
  "description": "A plain-English, local-first coding agent and developer workspace.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oasis": "./src/cli.mjs"
  },
  "files": [
