{
  "name": "oasis-oss",
  "version": "0.3.0",
  "description": "Open-source AI coding agent and local-first developer workspace with a CLI, browser UI, multi-provider LLMs, MCP integrations, skills, hooks, memory, and subagents.",
  "type": "module",
  "main": "./src/sdk.mjs",
  "exports": {
    ".": "./src/sdk.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "bin": {
    "oasis": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "index.html",
    "manifest.webmanifest",
    "sw.js",
    "assets/",
    "scripts/",
    "skills/",
    "plugins/",
    "ide/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/",
    "evals/",
    "desktop/"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-site.mjs && node .github/scripts/check-public-site.mjs && node --test && node src/cli.mjs eval --validate",
    "postinstall": "node scripts/vendor-terminal.mjs",
    "prepack": "node scripts/vendor-terminal.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:dir": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "bench:search": "node scripts/bench-web-search.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FAHTHIZ/oasis.git"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "ai-agents",
    "developer-tools",
    "developer-workspace",
    "cli",
    "terminal-agent",
    "llm",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "agentic-workflows",
    "local-first",
    "open-source",
    "javascript",
    "nodejs",
    "automation",
    "subagents",
    "ollama",
    "multi-provider"
  ],
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.4.0"
  },
  "build": {
    "appId": "org.oasis.oss",
    "productName": "OASIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "desktop/**/*",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*",
      "skills/**/*",
      "plugins/**/*",
      "ide/**/*",
      "docs/**/*",
      "package.json",
      "LICENSE",
      "SECURITY.md",
      "CONTRIBUTING.md"
    ],
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OASIS"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "author": {
    "name": "OASIS Contributors",
    "email": "noreply@github.com"
  }
}
