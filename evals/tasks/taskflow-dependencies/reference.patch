diff --git a/src/deps.mjs b/src/deps.mjs
new file mode 100644
index 0000000..d5108b2
--- /dev/null
+++ b/src/deps.mjs
@@ -0,0 +1,37 @@
+// Task dependencies. A task's `blockedBy` lists the IDs of tasks that must be
+// done first; files written before dependencies existed have no such field.
+export function blockersOf(task) {
+  return Array.isArray(task.blockedBy) ? task.blockedBy : [];
+}
+
+// Open blockers of `task`, ascending. Done or missing blockers do not count.
+export function openBlockers(task, tasks) {
+  const open = new Set(tasks.filter((t) => t.status !== 'done').map((t) => t.id));
+  return blockersOf(task).filter((id) => open.has(id)).sort((a, b) => a - b);
+}
+
+export function isBlocked(task, tasks) {
+  return task.status !== 'done' && openBlockers(task, tasks).length > 0;
+}
+
+// Path from `start` back to `target` following blockedBy edges, or null.
+// Neighbours are visited in ascending order so the reported path is stable.
+function findPath(start, target, byId, seen = new Set()) {
+  if (start === target) return [start];
+  if (seen.has(start)) return null;
+  seen.add(start);
+  const task = byId.get(start);
+  if (!task) return null;
+  for (const next of [...blockersOf(task)].sort((a, b) => a - b)) {
+    const rest = findPath(next, target, byId, seen);
+    if (rest) return [start, ...rest];
+  }
+  return null;
+}
+
+// Throws when making `id` wait on `blocker` would close a loop.
+export function assertNoCycle(id, blocker, tasks) {
+  const byId = new Map(tasks.map((t) => [t.id, t]));
+  const loop = findPath(blocker, id, byId);
+  if (loop) throw new Error(`Dependency cycle: ${[id, ...loop].join(' -> ')}`);
+}
