diff --git a/test/deps.test.mjs b/test/deps.test.mjs
new file mode 100644
index 0000000..a31d6e8
--- /dev/null
+++ b/test/deps.test.mjs
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { openStore } from '../src/store.mjs';
+import { run } from '../src/cli.mjs';
+import { NOW, tempFile, sink } from './helpers.mjs';
+
+const now = () => NOW;
+
+test('block, unblock and cycle detection', async (t) => {
+  const store = await openStore(await tempFile(t), { now });
+  for (const title of ['a', 'b', 'c']) await store.add({ title });
+  assert.deepEqual((await store.block(3, [2, 1, 2])).blockedBy, [1, 2]);
+  await store.block(2, [1]);
+  await assert.rejects(store.block(1, [3]), { message: 'Dependency cycle: 1 -> 3 -> 1' });
+  await assert.rejects(store.block(1, [1]), /cannot block itself/);
+  await assert.rejects(store.block(1, [9]), /No task with ID 9/);
+  assert.deepEqual(store.get(1).blockedBy, []);
+  assert.deepEqual((await store.unblock(3, [1, 7])).blockedBy, [2]);
+});
+
+test('blocked tasks cannot be completed until their blockers are done', async (t) => {
+  const store = await openStore(await tempFile(t), { now });
+  await store.add({ title: 'a' });
+  await store.add({ title: 'b' });
+  await store.block(2, [1]);
+  await assert.rejects(store.update(2, { status: 'done' }), { message: 'Task 2 is blocked by 1' });
+  await store.update(1, { status: 'done' });
+  assert.equal((await store.update(2, { status: 'done' })).status, 'done');
+});
+
+test('removing a task drops it from blockedBy lists', async (t) => {
+  const file = await tempFile(t);
+  const store = await openStore(file, { now });
+  await store.add({ title: 'a' });
+  await store.add({ title: 'b' });
+  await store.block(2, [1]);
+  await store.remove(1);
+  assert.deepEqual(store.get(2).blockedBy, []);
+  const saved = JSON.parse(await readFile(file, 'utf8'));
+  assert.deepEqual(saved.tasks[0].blockedBy, []);
+});
+
+test('old files without blockedBy still load and list', async (t) => {
+  const file = await tempFile(t);
+  await writeFile(file, JSON.stringify({ version: 1, tasks: [{ id: 1, title: 'old', priority: 'normal', status: 'open', due: null, tags: [], notes: '', created: NOW.toISOString() }] }));
+  const out = sink();
+  await run(['list', '--status', 'ready'], { stdout: out, env: { TASKFLOW_FILE: file }, now });
+  assert.match(out.text, /old/);
+  const store = await openStore(file, { now });
+  assert.deepEqual(store.get(1).blockedBy, []);
+});
+
+test('CLI block/unblock, blocked and ready filters, and list markers', async (t) => {
+  const env = { TASKFLOW_FILE: await tempFile(t) };
+  const say = async (...args) => { const out = sink(); await run(args, { stdout: out, env, now }); return out.text; };
+  await say('add', 'design');
+  await say('add', 'build');
+  await say('add', 'ship');
+  assert.equal(await say('block', '3', '2', '1'), 'Task 3 is blocked by 1, 2.\n');
+  assert.equal(await say('list', '--status', 'blocked'), '  3 [ ] · ship (blocked by #1, #2)\n');
+  assert.equal(await say('list', '--status', 'ready'), '  1 [ ] · design\n  2 [ ] · build\n');
+  await say('done', '1');
+  assert.match(await say('list'), / {2}3 \[ \] · ship \(blocked by #2\)\n$/);
+  assert.equal(await say('unblock', '3', '1'), 'Task 3 is blocked by 2.\n');
+  assert.equal(await say('unblock', '3', '2'), 'Task 3 is no longer blocked.\n');
+  await assert.rejects(run(['block', '1'], { stdout: sink(), env, now }), /at least one blocker/);
+});
