+test('listeners can unsubscribe', async () => {
+  const { createEmitter } = await import('../src/events.mjs');
+  const e = createEmitter();
+  const seen = [];
+  const off = e.on('x', (v) => seen.push(v));
+  e.emit('x', 1);
+  off();
+  e.emit('x', 2);
+  assert.deepEqual(seen, [1]);
+});
