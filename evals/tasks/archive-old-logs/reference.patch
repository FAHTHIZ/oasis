+#!/usr/bin/env node
+// Moves daily logs dated before --before YYYY-MM-DD into logs/archive/YYYY-MM/
+// and appends what moved to logs/archive/manifest.json.
+import { existsSync, mkdirSync, readdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+
+const args = process.argv.slice(2);
+const at = args.indexOf('--before');
+const before = at >= 0 ? args[at + 1] : '';
+if (!/^\d{4}-\d{2}-\d{2}$/.test(before || '')) {
+  console.error('usage: archive-logs.mjs --before YYYY-MM-DD [--dir logs]');
+  process.exit(2);
+}
+const dirAt = args.indexOf('--dir');
+const dir = path.resolve(dirAt >= 0 ? args[dirAt + 1] : 'logs');
+const archive = path.join(dir, 'archive');
+const manifestPath = path.join(archive, 'manifest.json');
+const manifest = existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : { moved: [] };
+for (const name of readdirSync(dir).sort()) {
+  const match = /^app-(\d{4})-(\d{2})-(\d{2})\.log$/.exec(name);
+  if (!match) continue;
+  const date = match[1] + '-' + match[2] + '-' + match[3];
+  if (date >= before) continue;
+  const target = path.join(archive, match[1] + '-' + match[2]);
+  mkdirSync(target, { recursive: true });
+  renameSync(path.join(dir, name), path.join(target, name));
+  manifest.moved.push({ file: name, to: path.relative(dir, path.join(target, name)).split(path.sep).join('/') });
+}
+mkdirSync(archive, { recursive: true });
+writeFileSync(manifestPath, JSON.stringify(manifest, null, 2) + '\n');
