diff --git a/src/query.mjs b/src/query.mjs
index 412a40b..a5ab571 100644
--- a/src/query.mjs
+++ b/src/query.mjs
@@ -31,5 +31,5 @@ export function paginate(items, page = 1, size = 20) {
