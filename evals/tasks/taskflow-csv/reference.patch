diff --git a/test/csv.test.mjs b/test/csv.test.mjs
new file mode 100644
index 0000000..55fc1fe
--- /dev/null
+++ b/test/csv.test.mjs
@@ -0,0 +1,55 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { parseCsv, exportCsv } from '../src/csv.mjs';
+import { openStore } from '../src/store.mjs';
+import { run } from '../src/cli.mjs';
+import { NOW, tempFile, sink } from './helpers.mjs';
+
+const now = () => NOW;
+
+test('parseCsv handles quotes, line breaks, CRLF, BOM and blank lines', () => {
+  assert.deepEqual(parseCsv('\ufeffa,b\r\n"x,""y""\nz",2\n\n3,\n'), [['a', 'b'], ['x,"y"\nz', '2'], ['3', '']]);
+  assert.deepEqual(parseCsv('a\n""'), [['a'], ['']]);
+  assert.deepEqual(parseCsv(''), []);
+  assert.throws(() => parseCsv('a\n"b\nc'), { message: 'CSV line 2: unterminated quoted field' });
+  assert.throws(() => parseCsv('a\nb"c'), { message: 'CSV line 2: unexpected quote' });
+  assert.throws(() => parseCsv('"a"x'), { message: 'CSV line 1: unexpected quote' });
+});
+
+test('exportCsv quotes when needed and guards formulas', () => {
+  const text = exportCsv([{ id: 1, title: '=SUM(A1)', priority: 'high', status: 'open', due: null, tags: ['a', 'b'], notes: 'say "hi", ok', created: '2026-11-01T00:00:00.000Z' }]);
+  assert.equal(text, 'id,title,priority,status,due,tags,notes,created,completed\n1,\'=SUM(A1),high,open,,a;b,"say ""hi"", ok",2026-11-01T00:00:00.000Z,\n');
+});
+
+test('importCsv validates every row before saving and round-trips exports', async (t) => {
+  const file = await tempFile(t);
+  const store = await openStore(file, { now });
+  await store.add({ title: 'existing' });
+  await assert.rejects(store.importCsv('title,priority\nok,\nbad,urgent\n'), { message: 'CSV row 2: Unknown priority: urgent' });
+  assert.equal(store.all().length, 1);
+  await assert.rejects(store.importCsv('title,colour\nx,red\n'), { message: 'Unknown CSV column: colour' });
+  await assert.rejects(store.importCsv('priority\nhigh\n'), { message: 'Missing CSV column: title' });
+  const added = await store.importCsv('tags,title,status,due\nA;;b,"=1+1",done,2026-12-01\n');
+  assert.equal(added[0].id, 2);
+  assert.equal(added[0].title, '=1+1');
+  assert.deepEqual(added[0].tags, ['a', 'b']);
+  assert.equal(added[0].completed, NOW.toISOString());
+  const again = await openStore(file, { now });
+  const copy = await again.importCsv(exportCsv(again.all()));
+  assert.deepEqual(copy.map((task) => task.title), ['existing', '=1+1']);
+});
+
+test('taskflow export and import', async (t) => {
+  const env = { TASKFLOW_FILE: await tempFile(t) };
+  const say = async (...args) => { const out = sink(); await run(args, { stdout: out, env, now }); return out.text; };
+  await say('add', 'one');
+  await say('add', 'two');
+  await say('done', '2');
+  assert.equal((await say('export', '--status', 'open')).split('\n').length, 3);
+  const source = env.TASKFLOW_FILE + '.csv';
+  await writeFile(source, await say('export'));
+  assert.equal(await say('import', source), 'Imported 2 task(s).\n');
+  assert.equal(JSON.parse(await readFile(env.TASKFLOW_FILE, 'utf8')).tasks.length, 4);
+  assert.match(await say('help'), /export\|import/);
+});
