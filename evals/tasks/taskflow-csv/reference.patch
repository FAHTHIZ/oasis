+    async importCsv(text) {
+      const records = parseCsv(text);
+      if (!records.length) return [];
+      const header = records[0].map((name) => name.trim());
+      const seen = new Set();
+      for (const name of header) {
+        if (!CSV_COLUMNS.includes(name)) throw new Error(`Unknown CSV column: ${name}`);
+        if (seen.has(name)) throw new Error(`Duplicate CSV column: ${name}`);
+        seen.add(name);
+      }
+      if (!seen.has('title')) throw new Error('Missing CSV column: title');
+      const stamp = (value) => {
+        if (value === '') return null;
+        const ms = Date.parse(value);
+        if (Number.isNaN(ms)) throw new Error(`Invalid timestamp: ${value}`);
+        return new Date(ms).toISOString();
+      };
+      const created = [];
+      let pool = tasks;
+      records.slice(1).forEach((record, index) => {
+        try {
+          if (record.length !== header.length) throw new Error(`expected ${header.length} fields, found ${record.length}`);
+          const row = Object.fromEntries(header.map((name, i) => [name, record[i]]));
+          const due = row.due === undefined || row.due === '' ? '' : row.due;
+          if (due && !/^\d{4}-\d{2}-\d{2}$/.test(due)) throw new Error(`Invalid due date: ${due}`);
+          const status = row.status === undefined || row.status === '' ? 'open' : row.status;
+          if (status !== 'open' && status !== 'done') throw new Error(`Unknown status: ${status}`);
+          const createdAt = stamp(row.created ?? '');
+          const completedAt = stamp(row.completed ?? '');
+          const when = now();
+          const task = createTask({
+            title: unguard(row.title ?? ''),
+            priority: row.priority || undefined,
+            due: due || undefined,
+            tags: (row.tags ?? '').split(';').filter((tag) => tag !== ''),
+            notes: row.notes ? unguard(row.notes) : undefined
+          }, { id: nextId(pool), now: when });
+          if (due) task.due = parseDue(due, when);
+          if (createdAt) task.created = createdAt;
+          if (status === 'done') { task.status = 'done'; task.completed = completedAt || when.toISOString(); }
+          created.push(task);
+          pool = [...pool, task];
+        } catch (error) {
+          throw new Error(`CSV row ${index + 1}: ${error.message}`);
+        }
+      });
+      if (!created.length) return [];
+      tasks = pool;
+      await save();
+      for (const task of created) events.emit('added', task);
+      return created;
+    },
