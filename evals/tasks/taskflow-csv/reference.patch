diff --git a/src/csv.mjs b/src/csv.mjs
new file mode 100644
index 0000000..7dd10ef
--- /dev/null
+++ b/src/csv.mjs
@@ -0,0 +1,93 @@
+// CSV in the RFC 4180 dialect: comma-separated, LF or CRLF records, double-quoted
+// fields that may hold commas, line breaks and "" for a quote.
+export const CSV_COLUMNS = ['id', 'title', 'priority', 'status', 'due', 'tags', 'notes', 'created', 'completed'];
+
+export function parseCsv(text) {
+  let input = String(text);
+  if (input.charCodeAt(0) === 0xfeff) input = input.slice(1);
+  const records = [];
+  let record = [];
+  let field = '';
+  let line = 1;
+  let i = 0;
+  let fieldStarted = false;
+  let quoted = false;
+  const endField = () => { record.push(field); field = ''; fieldStarted = false; };
+  const endRecord = () => {
+    endField();
+    if (!(record.length === 1 && record[0] === '' && !quoted)) records.push(record);
+    record = [];
+    quoted = false;
+  };
+  while (i < input.length) {
+    const ch = input[i];
+    if (ch === '"' && !fieldStarted) {
+      const startLine = line;
+      i++;
+      for (;;) {
+        if (i >= input.length) throw new Error(`CSV line ${startLine}: unterminated quoted field`);
+        const c = input[i];
+        if (c === '"') {
+          if (input[i + 1] === '"') { field += '"'; i += 2; continue; }
+          i++;
+          break;
+        }
+        if (c === '\n') line++;
+        field += c;
+        i++;
+      }
+      fieldStarted = true;
+      quoted = true;
+      const next = input[i];
+      if (next !== undefined && next !== ',' && next !== '\n' && !(next === '\r' && input[i + 1] === '\n')) throw new Error(`CSV line ${line}: unexpected quote`);
+      continue;
+    }
+    if (ch === ',') { endField(); i++; continue; }
+    if (ch === '\n' || (ch === '\r' && input[i + 1] === '\n')) {
+      endRecord();
+      i += ch === '\r' ? 2 : 1;
+      line++;
+      continue;
+    }
+    if (ch === '"') throw new Error(`CSV line ${line}: unexpected quote`);
+    field += ch;
+    fieldStarted = true;
+    i++;
+  }
+  if (fieldStarted || field !== '' || record.length) endRecord();
+  return records;
+}
+
+const FORMULA_START = /^[=+\-@]/;
+
+function quote(value) {
+  const text = String(value);
+  return /[",\r\n]|^ | $/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
+}
+
+function guard(value) {
+  const text = String(value ?? '');
+  return FORMULA_START.test(text) ? "'" + text : text;
+}
+
+export function exportCsv(tasks) {
+  const lines = [CSV_COLUMNS.join(',')];
+  for (const task of tasks) {
+    lines.push([
+      task.id,
+      guard(task.title),
+      task.priority,
+      task.status,
+      task.due || '',
+      (task.tags || []).join(';'),
+      guard(task.notes),
+      task.created || '',
+      task.completed || ''
+    ].map(quote).join(','));
+  }
+  return lines.join('\n') + '\n';
+}
+
+export function unguard(value) {
+  return /^'[=+\-@]/.test(value) ? value.slice(1) : value;
+}
