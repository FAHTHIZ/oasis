--- a/src/cli.mjs
+++ b/src/cli.mjs
@@ -9,7 +9,7 @@ import { formatList } from './format.mjs';
 const VALUE_FLAGS = new Set(['priority', 'due', 'tag', 'status', 'sort', 'page', 'size', 'notes', 'file']);
 const BOOLEAN_FLAGS = new Set(['overdue', 'help']);
 
-// Supports --flag value and boolean --flag. "--" ends options.
+// Supports --flag value, --flag=value, and boolean --flag. "--" ends options.
 export function parseArgs(argv) {
   const positional = [];
   const flags = {};
@@ -18,14 +18,20 @@ export function parseArgs(argv) {
     const arg = argv[i];
     if (arg === '--') { positional.push(...argv.slice(i + 1)); break; }
     if (!arg.startsWith('--')) { positional.push(arg); continue; }
-    const name = arg.slice(2);
+    const eq = arg.indexOf('=');
+    const name = eq === -1 ? arg.slice(2) : arg.slice(2, eq);
     if (BOOLEAN_FLAGS.has(name)) {
+      if (eq !== -1) throw new Error(`--${name} does not take a value`);
       flags[name] = true;
       continue;
     }
     if (!VALUE_FLAGS.has(name)) throw new Error(`Unknown option: --${name}`);
-    const value = argv[++i];
-    if (value === undefined) throw new Error(`--${name} needs a value`);
+    let value;
+    if (eq !== -1) value = arg.slice(eq + 1);
+    else {
+      value = argv[++i];
+      if (value === undefined) throw new Error(`--${name} needs a value`);
+    }
     if (name === 'tag') tags.push(value);
     else flags[name] = value;
   }
