@@ -44,6 +44,15 @@ function parseId(text) {
   return Number(text);
 }
 
+function checkIds(store, args) {
+  if (!args.length) throw new Error('No task IDs given');
+  const ids = [...new Set(args.map(parseId))];
+  const known = new Set(store.all().map((task) => task.id));
+  const missing = ids.filter((id) => !known.has(id));
+  if (missing.length) throw new Error(`No task with ID ${missing.join(', ')}`);
+  return ids;
+}
