diff --git a/test/provider-setup-defaults.test.mjs b/test/provider-setup-defaults.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/provider-setup-defaults.test.mjs
@@ -0,0 +1,52 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  getProviderSetupDefaults,
+  DEFAULT_BASE_URL,
+  DEFAULT_ANTHROPIC_BASE_URL,
+  DEFAULT_MODEL
+} from '../src/config.mjs';
+
+test('fresh setup defaults to the native OpenAI Responses provider', () => {
+  assert.deepEqual(getProviderSetupDefaults({}), {
+    protocol: 'openai-responses',
+    baseURL: DEFAULT_BASE_URL,
+    model: DEFAULT_MODEL
+  });
+});
+
+test('reopening setup preserves a saved Anthropic provider', () => {
+  assert.deepEqual(getProviderSetupDefaults({
+    protocol: 'anthropic',
+    baseURL: DEFAULT_ANTHROPIC_BASE_URL,
+    model: 'claude-sonnet-5'
+  }), {
+    protocol: 'anthropic',
+    baseURL: DEFAULT_ANTHROPIC_BASE_URL,
+    model: 'claude-sonnet-5'
+  });
+});
+
+test('reopening setup preserves a saved compatible endpoint and model', () => {
+  assert.deepEqual(getProviderSetupDefaults({
+    protocol: 'openai-compatible',
+    baseURL: 'http://localhost:11434/v1',
+    model: 'local-model'
+  }), {
+    protocol: 'openai-compatible',
+    baseURL: 'http://localhost:11434/v1',
+    model: 'local-model'
+  });
+});
+
+test('unknown protocols keep valid custom endpoints in compatible mode', () => {
+  assert.deepEqual(getProviderSetupDefaults({
+    protocol: 'future-provider-protocol',
+    baseURL: 'https://gateway.example/v1',
+    model: 'custom-model'
+  }), {
+    protocol: 'openai-compatible',
+    baseURL: 'https://gateway.example/v1',
+    model: 'custom-model'
+  });
+});
