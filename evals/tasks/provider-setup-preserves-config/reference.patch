+export function getProviderSetupDefaults(saved = {}) {
+  const savedBaseURL = (() => {
+    try { return validateBaseUrl(saved.baseURL || ''); }
+    catch { return ''; }
+  })();
+  let protocol;
+  try {
+    protocol = validateProtocol(saved.protocol || inferProtocol(savedBaseURL, DEFAULT_PROTOCOL));
+  } catch {
+    protocol = inferProtocol(savedBaseURL, 'openai-compatible');
+  }
+  const baseURL = savedBaseURL || (
+    protocol === 'anthropic' ? DEFAULT_ANTHROPIC_BASE_URL :
+      protocol === 'openai-responses' ? DEFAULT_BASE_URL : ''
+  );
+  const defaultModel = protocol === 'anthropic' ? 'claude-sonnet-5' :
+    protocol === 'openai-responses' ? DEFAULT_MODEL : '';
+  const model = String(saved.model || defaultModel).trim();
+  return { protocol, baseURL, model };
+}
+
 function stripTrailingSlashes(raw) {
