diff --git a/src/format.mjs b/src/format.mjs
index 87286b2..875b465 100644
--- a/src/format.mjs
+++ b/src/format.mjs
@@ -26,6 +26,18 @@ export function formatTask(task, { now = new Date(), width = 40 } = {}) {
   return `${String(task.id).padStart(3)} ${box} ${MARK[task.priority]} ${truncate(task.title, width)}${tags}${due ? ` (${due})` : ''}`;
 }
 
+const csvField = (value) => {
+  const text = value === null || value === undefined ? '' : String(value);
+  return /[",\r\n]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
+};
+const safeText = (value) => (/^[=+\-@]/.test(String(value || '')) ? "'" + value : value || '');
+
+export function toCsv(tasks) {
+  const rows = [['id', 'title', 'priority', 'status', 'due', 'tags', 'notes']];
+  for (const task of [...tasks].sort((a, b) => a.id - b.id)) rows.push([task.id, safeText(task.title), task.priority, task.status, task.due, task.tags.join(';'), safeText(task.notes)]);
+  return rows.map((row) => row.map(csvField).join(',')).join('\r\n') + '\r\n';
+}
+
 export function formatList(tasks, options) {
   if (!tasks.length) return 'No tasks.';
   return tasks.map((task) => formatTask(task, options)).join('\n');
