+export function validateTodos(todos) { if (!Array.isArray(todos)) throw new Error('todos must be an array'); if (todos.length > 50) throw new Error('Keep 50 items or fewer'); const statuses = new Set(['pending', 'in_progress', 'completed']); const clean = todos.map((item) => { if (!item || typeof item.content !== 'string' || !item.content.trim()) throw new Error('content is required'); if (!statuses.has(item.status)) throw new Error('invalid status'); return { content: item.content.trim().slice(0, 200), status: item.status }; }); if (clean.filter((item) => item.status === 'in_progress').length > 1) throw new Error('Only one item may be in_progress'); return clean; }
