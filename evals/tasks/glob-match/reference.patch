+export function globMatches(pattern, candidate) { const escape = (text) => String(text).replaceAll('\\', '\\\\').replaceAll('.', '\\.').replaceAll('+', '\\+').replaceAll('^', '\\^').replaceAll('$', '\\$').replaceAll('{', '\\{').replaceAll('}', '\\}').replaceAll('(', '\\(').replaceAll(')', '\\)').replaceAll('|', '\\|').replaceAll('[', '\\[').replaceAll(']', '\\]'); const source = String(pattern).split(/([*?])/).map((part) => part === '*' ? '[^/]*' : part === '?' ? '[^/]' : escape(part)).join(''); return new RegExp('^' + source + '$').test(String(candidate)); }
