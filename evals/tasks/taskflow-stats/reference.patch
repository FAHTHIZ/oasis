diff --git a/src/query.mjs b/src/query.mjs
index a5ab571..9105c90 100644
--- a/src/query.mjs
+++ b/src/query.mjs
@@ -26,6 +26,13 @@ export function sortTasks(tasks, key = 'id') {
   return [...tasks].sort((a, b) => compare(a, b) || a.id - b.id);
 }
 
+export function summarize(tasks, now = new Date()) {
+  const open = tasks.filter((task) => task.status === 'open');
+  const byPriority = { high: 0, normal: 0, low: 0 };
+  for (const task of open) byPriority[task.priority] = (byPriority[task.priority] || 0) + 1;
+  return { open: open.length, done: tasks.length - open.length, overdue: open.filter((task) => isOverdue(task, now)).length, byPriority };
+}
