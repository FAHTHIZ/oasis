+export function isSensitivePath(value) { const parts = String(value || '').split(/[\\/]+/).filter(Boolean).map((part) => part.toLowerCase()); return parts.some((part) => ['.env', '.ssh', '.aws', 'credentials', 'id_rsa', 'id_ed25519'].includes(part) || part.startsWith('.env.')); }
