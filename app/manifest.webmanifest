{
  "id": "./",
  "name": "OASIS",
  "short_name": "OASIS",
  "description": "Independent coding agent that runs on your own phone, tablet or computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0B100C",
  "theme_color": "#0B100C",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    { "src": "icons/oasis-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/oasis-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/oasis-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/oasis-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Open a GitHub repository", "url": "./?repo=", "icons": [{ "src": "icons/oasis-192.png", "sizes": "192x192" }] }
  ],
  "share_target": { "action": "./", "method": "GET", "params": { "text": "q", "url": "u" } }
}
